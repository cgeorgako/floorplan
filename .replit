# Ρύθμιση Replit — άνοιξε το repo στο Replit και πάτησε «Run».
run = ["bash", "-c", "pip install reportlab Flask >/dev/null 2>&1 && (pip install PyMuPDF >/dev/null 2>&1 || echo 'PyMuPDF προαιρετικό — παραλείπεται'); python -m webapp.app"]
entrypoint = "webapp/app.py"
modules = ["python-3.12", "web", "nix"]

[nix]
channel = "stable-25_05"

[env]
HOST = "0.0.0.0"
PORT = "5000"

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pip install reportlab Flask PyMuPDF 2>&1 | tail -3 && python -m webapp.app"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[deployment]
deploymentTarget = "autoscale"
run = ["gunicorn", "--bind=0.0.0.0:5000", "--reuse-port", "webapp.app:app"]
